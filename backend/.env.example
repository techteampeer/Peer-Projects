# ============ GLPI ============
GLPI_BASE_URL=https://glpi.peer-consulting.com/apirest.php
GLPI_ENTITY_ID=1
GLPI_APP_TOKEN=            # secret — inject via Secret Manager in Cloud Run
GLPI_USER_TOKEN=           # secret — inject via Secret Manager in Cloud Run
GLPI_DEVELOPER_GROUP_ID=   # the GLPI id of the "Developers" group (see /api/developers)

# ============ Google Cloud Storage (attachments) ============
# NOTE: this was missing from the current Cloud Run "Variables & Secrets"
# screen — add it alongside the others, or gcs.js has nothing to upload to.
GCS_BUCKET_NAME=oath-tickets-poc

# ============ GCP project (kept for parity with other services /
# reserved for when this flow adds AI-assisted routes) ============
GCP_PROJECT=itservicedesk-502618
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
AI_MODE=vertex

PORT=8080
